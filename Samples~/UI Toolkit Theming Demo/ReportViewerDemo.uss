.viewer-root {
    flex-grow: 1;
    padding: 48px;
    justify-content: center;
    align-items: center;
}

.viewer-panel {
    padding: 32px;
    width: 85%;
    max-width: 900px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
}

.viewer-title {
    font-size: 32px;
    -unity-font-style: bold;
}

.viewer-body {
    margin-top: 20px;
    font-size: 18px;
    white-space: normal;
}

.viewer-button {
    margin-top: 24px;
    margin-right: 12px;
    height: 48px;
    min-width: 150px;
    font-size: 18px;
}

.actions {
    flex-direction: row;
    flex-wrap: wrap;
}
